{
  "name": "cobalt2-theme",
  "version": "0.1.2",
  "description": "Cobalt2 themes and installers for coding agents and developer tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalitmee/cobalt2.git"
  },
  "homepage": "https://github.com/lalitmee/cobalt2#readme",
  "bugs": {
    "url": "https://github.com/lalitmee/cobalt2/issues"
  },
  "keywords": [
    "cobalt2",
    "theme",
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "pi",
    "tmux",
    "ghostty",
    "bat",
    "terminal",
    "cli"
  ],
  "type": "module",
  "bin": {
    "cobalt2-theme": "bin/cobalt2-theme.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "catalog/",
    "themes/",
    "palette/",
    "snippets/",
    "VERSION",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-assets.js",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-release.js",
    "release:prepare": "node scripts/prepare-release.js",
    "prepublishOnly": "npm run check:release"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1"
  }
}
