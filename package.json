{
  "name": "cobalt2-theme",
  "version": "0.1.1",
  "description": "Cobalt2 themes and installers for coding agents and developer tools",
  "type": "module",
  "bin": {
    "cobalt2-theme": "bin/cobalt2-theme.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "catalog/",
    "themes/",
    "palette/",
    "snippets/",
    "VERSION",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-assets.js",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-release.js",
    "release:prepare": "node scripts/prepare-release.js",
    "prepublishOnly": "npm run check:release"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
